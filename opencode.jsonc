{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/deepseek-v4-flash",
  "subagent_depth": 1,
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "permission": {
    "external_directory": "deny",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git commit *": "ask",
      "git push *": "deny",
      "git merge *": "deny",
      "git reset --hard *": "deny",
      "rm *": "deny"
    }
  },
  "agent": {
    "build": {
      "description": "Ejecutor de work orders aprobadas del proyecto.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro",
      "permission": {
        "external_directory": "deny",
        "edit": "allow",
        "task": {
          "explore": "allow",
          "promueve-review": "allow",
          "*": "deny"
        },
        "bash": {
          "*": "ask",
          "git *": "allow",
          "git commit *": "ask",
          "git push *": "deny",
          "git merge *": "deny",
          "git reset --hard *": "deny",
          "rm *": "deny"
        }
      }
    },
    "plan": {
      "description": "Preflight y diagnóstico sin escritura.",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "low",
      "permission": {
        "external_directory": "deny",
        "edit": "deny",
        "task": {
          "explore": "allow",
          "*": "deny"
        },
        "bash": {
          "*": "deny",
          "git *": "deny",
          "git status*": "allow",
          "git rev-parse*": "allow",
          "git diff*": "allow",
          "find *": "allow",
          "grep *": "allow",
          "cat *": "allow",
          "sed *": "allow",
          "pwd": "allow"
        },
        "websearch": "deny",
        "webfetch": "deny"
      }
    },
    "explore": {
      "description": "Inventario y búsquedas read-only del repositorio.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "permission": {
        "external_directory": "deny",
        "edit": "deny",
        "task": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git rev-parse*": "allow",
          "git diff*": "allow",
          "find *": "allow",
          "grep *": "allow",
          "cat *": "allow",
          "sed *": "allow",
          "pwd": "allow"
        },
        "websearch": "deny",
        "webfetch": "deny"
      }
    },
    "general": {
      "hidden": true,
      "permission": {
        "task": "deny",
        "external_directory": "deny"
      }
    }
  }
}
